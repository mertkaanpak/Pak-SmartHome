# Kopiere diese Datei nach .env und trage deine echten Werte ein.
# Die .env-Datei wird NICHT ins Git eingecheckt (siehe .gitignore).

# Server
PORT=3001
DB_FILE=./data/smarthome.db

# --- Tuya / SmartLife (Rollläden) ---
# Anlegen unter https://iot.tuya.com  ->  Cloud  ->  Projekt erstellen
# Rechenzentrum: "Central Europe Data Center" waehlen!
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
TUYA_API_URL=https://openapi.tuyaeu.com

# --- Ring (Türklingel) ---
# Refresh-Token wird spaeter per Setup-Skript erzeugt (npx -p ring-client-api ring-auth-cli)
RING_REFRESH_TOKEN=
